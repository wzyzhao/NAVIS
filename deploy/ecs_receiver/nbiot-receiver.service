[Unit]
Description=NB-IoT NBT1 Payload Receiver and ACK Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nbiot-receiver
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nbiot-receiver/.venv/bin/python /opt/nbiot-receiver/receiver.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
